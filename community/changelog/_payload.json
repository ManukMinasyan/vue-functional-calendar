ef":27},"MIGRATION.md",".",[202,203,205],"h3",{"id":204},"added","Added",[207,208,209,217,223,233,236,245,251,257],"ul",{},[210,211,212,213,216],"li",{},"A Vue 3 build with ESM, CJS and UMD bundles, an ",[188,214,215],{},"exports"," map and type declarations.",[210,218,219,222],{},[188,220,221],{},"vue-functional-calendar\u002Fstyle.css",", the stylesheet as a separate import.",[210,224,225,226,229,230,200],{},"Theming with ",[188,227,228],{},"--vfc-*"," custom properties, and a dark mode through ",[188,231,232],{},"isDark",[210,234,235],{},"Keyboard navigation and an ARIA date grid, with focus management for modal calendars.",[210,237,186,238,241,242,200],{},[188,239,240],{},"locale"," prop, which derives day names, month names and the first day of the week from ",[188,243,244],{},"Intl",[210,246,186,247,250],{},[188,248,249],{},"labels"," prop, which translates every UI string.",[210,252,186,253,256],{},[188,254,255],{},"presets"," prop, with six built-in quick ranges and custom ranges.",[210,258,259],{},"A documentation site with live examples and a playground.",[202,261,263],{"id":262},"changed","Changed",[207,265,266,287,293,303,313,320],{},[210,267,268,271,272,275,276,271,279,282,283,286],{},[188,269,270],{},"value"," and ",[188,273,274],{},"input"," became ",[188,277,278],{},"modelValue",[188,280,281],{},"update:modelValue",". Templates that use ",[188,284,285],{},"v-model"," need no change.",[210,288,289,290,200],{},"The plugin installs with ",[188,291,292],{},"app.use(FunctionalCalendar, options)",[210,294,295,298,299,302],{},[188,296,297],{},"vue"," is a peer dependency, ",[188,300,301],{},"^3.3.0",". The package has no runtime dependencies.",[210,304,305,306,309,310,312],{},"The SCSS ",[188,307,308],{},"!default"," variables are replaced by ",[188,311,228],{}," tokens.",[210,314,315,316,319],{},"The default look is redesigned. The ",[188,317,318],{},"vfc-*"," class names are unchanged.",[210,321,322,323,326,327,200],{},"Deep imports from ",[188,324,325],{},"src\u002F"," no longer resolve. Import from ",[188,328,329],{},"vue-functional-calendar",[202,331,333],{"id":332},"fixed","Fixed",[207,335,336,343,354,361,364,371,374,377],{},[210,337,338,339,342],{},"Week numbers with ",[188,340,341],{},"sundayStart"," follow ISO numbering of each row's Thursday. They were one lower.",[210,344,345,346,349,350,353],{},"Typed dates are validated. ",[188,347,348],{},"31\u002F02\u002F2026"," is rejected, padded dates such as ",[188,351,352],{},"05\u002F03\u002F2026"," are accepted, and a value commits only when the date is complete.",[210,355,356,357,360],{},"A pasted or autofilled ISO date is reordered to ",[188,358,359],{},"dateFormat",", and pasted text that is not a date stays as pasted.",[210,362,363],{},"Typing with an input method editor no longer breaks the composition, and full-width digits are converted when it ends.",[210,365,366,367,370],{},"Text typed after the date in a ",[188,368,369],{},"displayTimeInput"," field is kept, and the input is long enough to hold the time.",[210,372,373],{},"ArrowDown no longer opens the calendar while an IME composes, or when the input already handled the key.",[210,375,376],{},"A navigation arrow slot that renders a focusable component is no longer wrapped in a second button.",[210,378,379,380,383],{},"An empty ",[188,381,382],{},"{}"," v-model receives typed dates, time picker changes and cleared values.",[180,385,387],{"id":386},"_2100-2026-10-17","2.10.0 - 2026-10-17",[176,389,390],{},"The last Vue 2 line. It ships a built bundle and types.",[202,392,205],{"id":393},"added-1",[207,395,396,402],{},[210,397,398,399,200],{},"TypeScript declarations in ",[188,400,401],{},"index.d.ts",[210,403,404,271,407,410],{},[188,405,406],{},"unpkg",[188,408,409],{},"jsdelivr"," entries that point at the UMD build.",[202,412,263],{"id":413},"changed-1",[207,415,416,432,439],{},[210,417,418,420,421,424,425,420,428,431],{},[188,419,297],{}," moved to ",[188,422,423],{},"peerDependencies",", and ",[188,426,427],{},"core-js",[188,429,430],{},"devDependencies",", because the polyfills are inlined at build time.",[210,433,434,435,438],{},"The build uses Dart Sass instead of ",[188,436,437],{},"node-sass",", which no longer installs on current Node.",[210,440,441],{},"The package builds before it is published.",[202,443,333],{"id":444},"fixed-1",[207,446,447,461],{},[210,448,449,452,453,456,457,460],{},[188,450,451],{},"main"," pointed at ",[188,454,455],{},"index.js",", which imports the raw ",[188,458,459],{},".vue"," sources, so every consumer had to compile the SCSS. It now points at the built bundle, so Vite projects without Sass work (#169).",[210,462,463],{},"TypeScript reported TS7016 for the missing declarations (#169).",{"title":465,"searchDepth":466,"depth":466,"links":467},"",2,[468,474],{"id":182,"depth":466,"text":183,"children":469},[470,472,473],{"id":204,"depth":471,"text":205},3,{"id":262,"depth":471,"text":263},{"id":332,"depth":471,"text":333},{"id":386,"depth":466,"text":387,"children":475},[476,477,478],{"id":393,"depth":471,"text":205},{"id":413,"depth":471,"text":263},{"id":444,"depth":471,"text":333},"Release notes for Vue Functional Calendar.","md",null,{},{"icon":169},{"title":166,"description":479},"9VFXEjVIZO-lXbWsGmK2sX58CnA3AbgbkqGK66SR-aY",[487,481],{"title":161,"path":162,"stem":163,"description":488,"icon":164,"children":-1},"Report bugs, propose changes and run the project locally.",1792278029878]