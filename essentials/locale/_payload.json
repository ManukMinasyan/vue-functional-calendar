62,463],{},"fa-IR",", ",[180,466,467],{},"ar-SA"," or ",[180,470,471],{},"th-TH",". The month is named with its Gregorian name and the year is the Gregorian year. The ",[180,474,475],{},"aria-label"," of each day uses the same names.",[365,478,480],{"id":479},"week-start","Week start",[176,482,483,484,487,488,491,492,495,496,499],{},"The first day of the week comes from ",[180,485,486],{},"Intl.Locale"," week info. The calendar uses ",[180,489,490],{},"getWeekInfo()"," where it exists, then the ",[180,493,494],{},"weekInfo"," property. Where the engine has neither, it falls back to a table of regions that start the week on Sunday, Saturday or Friday, and uses Monday for the rest. A first day of ",[180,497,498],{},"7"," counts as Sunday.",[176,501,502,504,505,508,509,512],{},[180,503,442],{}," overrides all of this. ",[180,506,507],{},"sundayStart: true"," starts on Sunday, ",[180,510,511],{},"false"," on Monday.",[176,514,515],{},"Week numbers follow the same first day.",[365,517,519],{"id":518},"labels","Labels",[176,521,522,524],{},[180,523,518],{}," covers every string the calendar writes. Pass only the ones you want to change. The rest keep their English text.",[192,526,528],{"className":194,"code":527,"language":196,"meta":197,"style":197},"\u003CFunctionalCalendar\n  v-model=\"value\"\n  is-date-range\n  can-clear-range\n  :presets=\"true\"\n  :labels=\"{\n    clearRange: 'Effacer la période',\n    quickRanges: 'Périodes rapides',\n    presets: { today: 'Aujourd\\'hui' },\n  }\"\n\u002F>\n",[180,529,530,536,549,554,559,577,590,609,625,656,663],{"__ignoreMap":197},[201,531,532,534],{"class":203,"line":204},[201,533,208],{"class":207},[201,535,287],{"class":211},[201,537,538,541,543,545,547],{"class":203,"line":222},[201,539,540],{"class":215},"  v-model",[201,542,232],{"class":207},[201,544,301],{"class":207},[201,546,319],{"class":228},[201,548,306],{"class":207},[201,550,551],{"class":203,"line":254},[201,552,553],{"class":215},"  is-date-range\n",[201,555,55