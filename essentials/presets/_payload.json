ass":203},"  \u003C",[197,695,208],{"class":207},[197,697,212],{"class":211},[197,699,215],{"class":203},[197,701,218],{"class":203},[197,703,222],{"class":221},[197,705,218],{"class":203},[197,707,227],{"class":211},[197,709,233],{"class":203},[197,711,181],{"class":211},[197,713,215],{"class":203},[197,715,218],{"class":203},[197,717,181],{"class":221},[197,719,218],{"class":203},[197,721,248],{"class":203},[197,723,725,727,729],{"class":199,"line":724},18,[197,726,666],{"class":203},[197,728,685],{"class":207},[197,730,481],{"class":203},[176,732,733,734,736,737,739],{},"The calendar calls ",[179,735,454],{}," each time it needs the preset, so \"today\" stays correct after midnight. Only the day of a returned date counts, not its time. A preset is skipped if ",[179,738,454],{}," throws, returns something that is not two valid dates, or returns an end before the start.",[741,742],"calendar-presets-demo",{},[250,744,746],{"id":745},"when-a-preset-is-disabled","When a preset is disabled",[176,748,749],{},"A preset is disabled when its whole range does not fit the rules of the calendar:",[751,752,753,765,775,789,795],"ul",{},[754,755,756,757,760,761,764],"li",{},"it is shorter than ",[179,758,759],{},"minSelDays"," or longer than ",[179,762,763],{},"maxSelDays"," (ranges only),",[754,766,767,768,771,772,418],{},"it starts before ",[179,769,770],{},"limits.min"," or ends after ",[179,773,774],{},"limits.max",[754,776,777,778,781,782,785,786,418],{},"it contains a date in ",[179,779,780],{},"disabledDates",", including ",[179,783,784],{},"beforeToday"," and ",[179,787,788],{},"afterToday",[754,790,791,792,418],{},"it contains a day of week from ",[179,793,794],{},"disabledDayNames",[754,796,797,798,596],{},"it contains a date outside ",[179,799,800],{},"enabledDates",[176,802,803,804,807],{},"A disabled preset keeps ",[179,805,806],{},"aria-disabled=\"true\"",", stays focusable, and does nothing when clicked. For a date picker, only the start date is checked.",[250,809