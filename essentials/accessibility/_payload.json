h",{},"Part",[199,203,204],{},"Markup",[206,207,208,221,231,246,256,267],"tbody",{},[196,209,210,214],{},[211,212,213],"td",{},"Month",[211,215,216,220],{},[217,218,219],"code",{},"role=\"grid\"",", named by the month and year, such as \"October 2026\"",[196,222,223,226],{},[211,224,225],{},"Week",[211,227,228],{},[217,229,230],{},"role=\"row\"",[196,232,233,236],{},[211,234,235],{},"Day",[211,237,238,241,242,245],{},[217,239,240],{},"role=\"gridcell\""," with a full date as ",[217,243,244],{},"aria-label",", such as \"Thursday, 15 October 2026\"",[196,247,248,251],{},[211,249,250],{},"Week number",[211,252,253],{},[217,254,255],{},"role=\"rowheader\"",[196,257,258,261],{},[211,259,260],{},"Day name row",[211,262,263,266],{},[217,264,265],{},"aria-hidden=\"true\"",", because each day already has a full date label",[196,268,269,272],{},[211,270,271],{},"Filler rows",[211,273,274,277,278],{},[217,275,276],{},"role=\"presentation\""," and ",[217,279,265],{},[176,281,282,283,286],{},"Day labels and the month name use the calendar's own names and the locale you set, always in the Gregorian calendar. Custom ",[217,284,285],{},"monthNames"," appear in the labels.",[185,288,290],{"id":289},"day-states","Day states",[292,293,294,301,322,328],"ul",{},[295,296,297,300],"li",{},[217,298,299],{},"aria-selected"," is set on days when the calendar selects something. It is absent on a display-only calendar.",[295,302,303,306,307,310,311,310,314,317,318,321],{},[217,304,305],{},"aria-disabled=\"true\""," marks days blocked by ",[217,308,309],{},"limits",", ",[217,312,313],{},"disabledDates",[217,315,316],{},"enabledDates"," or ",[217,319,320],{},"disabledDayNames",".",[295,323,324,325,321],{},"A day in a numbered range has its range number added to the label, such as \"Thursday, 15 October 2026, Range 2\". The word comes from ",[217,326,327],{},"labels.range",[295,329,330,331,321],{},"Days in a multiple date range carry ",[217,332,333],{},"aria-keyshortcuts=\"Delete\"",[185,335,337],{"id":336},"roving-focus","Roving focus",[176,339,340,341,344],{},"Each month has one tab stop, so Tab crosses the grid in one step. The stop sits on the day you last focused, then on the selected day, then on today, then on the first enabled day. The other days have ",[217,342,343],{},"tabindex=\"-1\""," and are reached with the arrow keys.",[176,346,347],{},"Focus stays on the same day when the calendar re-renders, for example after a month change. If that day leaves the screen, focus goes to the tab stop of the same month.",[185,349,351],{"id":350},"controls","Controls",[190,353,354,363],{},[193,355,356],{},[196,357,358,361],{},[199,359,360],{},"Control",[199,362,204],{},[206,364,365,387,404,418,437,449,473],{},[196,366,367,370],{},[211,368,369],{},"Arrows",[211,371,372,375,376,317,379,382,383,386],{},[217,373,374],{},"\u003Cbutton>"," with the label from ",[217,377,378],{},"labels.previousMonth",[217,380,381],{},"labels.nextMonth",", and ",[217,384,385],{},"aria-disabled"," at a limit",[196,388,389,392],{},[211,390,391],{},"Month and year titles",[211,393,394,310,397,277,400,403],{},[217,395,396],{},"role=\"button\"",[217,398,399],{},"tabindex=\"0\"",[217,401,402],{},"aria-expanded",", when the pickers are on",[196,405,406,409],{},[211,407,408],{},"Picker items",[211,410,411,413,414,417],{},[217,412,396],{}," with ",[217,415,416],{},"aria-pressed"," on the current one",[196,419,420,422],{},[211,421,86],{},[211,423,424,425,428,429,432,433,277,435],{},"A ",[217,426,427],{},"role=\"group\""," named by ",[217,430,431],{},"labels.quickRanges",", holding buttons with ",[217,434,416],{},[217,436,385],{},[196,438,439,442],{},[211,440,441],{},"Clear button",[211,443,444,413,446,448],{},[217,445,396],{},[217,447,385],{}," when there is nothing to clear",[196,450,451,453],{},[211,452,46],{},[211,454,455,456,459,460,277,463,466,467,470,471],{},"Two ",[217,457,458],{},"role=\"listbox\""," lists named by ",[217,461,462],{},"labels.hour",[217,464,465],{},"labels.minute",", with ",[217,468,469],{},"role=\"option\""," items and ",[217,472,299],{},[196,474,475,478],{},[211,476,477],{},"Time picker close",[211,479,480,482,483],{},[217,481,396],{}," labeled by ",[217,484,485],{},"labels.close",[176,487,488],{},"Arrow slots with your own button or link keep their own focus and semantics.",[185,490,492],{"id":491},"modal-calendars","Modal calendars",[176,494,495,496,428,499,502,503,506,507,509,510,513,514,310,517,317,520,321],{},"In modal mode, the calendar is a ",[217,497,498],{},"role=\"dialog\"",[217,500,501],{},"labels.calendar",". Its inputs have ",[217,504,505],{},"aria-haspopup=\"dialog\""," and an ",[217,508,402],{}," that tracks the dialog, and a ",[217,511,512],{},"title"," from ",[217,515,516],{},"labels.date",[217,518,519],{},"labels.startDate",[217,521,522],{},"labels.endDate",[176,524,525],{},"Focus follows these rules:",[292,527,528,531,534,537,540],{},[295,529,530],{},"Focusing an input, or pressing ArrowDown or Alt+ArrowDown on it, opens the calendar.",[295,532,533],{},"Escape closes the calendar and returns focus to the input that opened it.",[295,535,536],{},"Selecting a day with the keyboard in an auto-closing calendar returns focus to the input.",[295,538,539],{},"Focus leaving the calendar and its inputs closes it.",[295,541,542],{},"Escape inside a month or year picker, or the time picker, closes only that layer.",[185,544,546],{"id":545},"focus-ring","Focus ring",[176,548,549,550,553],{},"Focused controls show a 2px outline in ",[217,551,552],{},"--vfc-focus",". It defaults to the primary color, so change it if your primary color has low contrast on your background.",[185,555,557],{"id":556},"translate-it","Translate it",[176,559,560,561,564,565,568,569,321],{},"Every string a screen reader hears comes from ",[217,562,563],{},"labels"," or from ",[217,566,567],{},"locale",". See ",[180,570,571],{"href":82},"locale and labels",{"title":573,"searchDepth":574,"depth":574,"links":575},"",2,[576,577,578,579,580,581,582],{"id":187,"depth":574,"text":188},{"id":289,"depth":574,"text":290},{"id":336,"depth":574,"text":337},{"id":350,"depth":574,"text":351},{"id":491,"depth":574,"text":492},{"id":545,"depth":574,"text":546},{"id":556,"depth":574,"text":557},"Grid semantics, labels and focus management.","md",null,{},{"icon":94},{"title":91,"description":583},"SL8Ybg0ITBa1_tKXgiAs65RgvHCMq1AEHi4U825Qu70",[591,593],{"title":86,"path":87,"stem":88,"description":592,"icon":89,"children":-1},"Quick ranges for date ranges and date pickers.",{"title":96,"path":97,"stem":98,"description":594,"icon":99,"children":-1},"Every prop, with its type and default.",1792278029444]