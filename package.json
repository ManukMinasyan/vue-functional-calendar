{
  "author": {
    "name": "Manuk Minasyan",
    "email": "manuk.minasyan1@gmail.com",
    "url": "https://github.com/ManukMinasyan"
  },
  "name": "vue-functional-calendar",
  "description": "Lightweight, high-performance calendar component based on Vue.js",
  "version": "3.1.1",
  "license": "MIT",
  "homepage": "https://manukminasyan.github.io/vue-functional-calendar/",
  "bugs": {
    "url": "https://github.com/ManukMinasyan/vue-functional-calendar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManukMinasyan/vue-functional-calendar.git"
  },
  "keywords": [
    "vue",
    "calendar",
    "component",
    "vue-component",
    "functional",
    "date picker",
    "date range",
    "range",
    "multiple calendars",
    "multiple",
    "modal calendar",
    "modal",
    "inline",
    "date",
    "change month",
    "change year",
    "picker",
    "day",
    "month",
    "year",
    "time",
    "add",
    "cli",
    "command",
    "keys",
    "keyword",
    "keywords",
    "line",
    "package",
    "pkg"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/vue-functional-calendar.cjs",
  "module": "./dist/vue-functional-calendar.js",
  "types": "./index.d.ts",
  "unpkg": "./dist/vue-functional-calendar.umd.js",
  "jsdelivr": "./dist/vue-functional-calendar.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./dist/vue-functional-calendar.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./dist/vue-functional-calendar.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts",
    "index.d.cts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.umd.config.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src tests index.js --no-error-on-unmatched-pattern",
    "prepublishOnly": "npm run build",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run generate"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39",
    "@vitejs/plugin-vue": "^6.0",
    "@vue/test-utils": "^2.5",
    "autoprefixer": "^10.4",
    "eslint": "^9.39",
    "eslint-plugin-vue": "^10.11",
    "globals": "^17.13",
    "jsdom": "^30.1",
    "prettier": "^3.9",
    "sass": "^1.105",
    "vite": "^8.3",
    "vitest": "^5.0",
    "vue": "^3.5"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
