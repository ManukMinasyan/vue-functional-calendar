196,197],{"v-slot:title":172},"Vue Functional ",[198,199,202],"span",{"className":200},[201],"text-primary","Calendar",[182,204,205],{"v-slot:description":172},"A lightweight calendar and datepicker for Vue 3. Pick single dates, ranges with presets, several months or a time, with keyboard support, dark mode and Intl locales built in. No runtime dependencies.",[182,207,208,212],{"v-slot:links":172},[185,209,211],{"size":210,"to":17,"trailing-icon":188},"xl","Get started",[213,214],"install-command",{},[216,217],"calendar-hero",{},[219,220,221,224,231],"u-page-section",{},[182,222,223],{"v-slot:title":172},"Why Vue Functional Calendar?",[182,225,226],{"v-slot:links":172},[185,227,230],{"size":228,"to":117,"trailing-icon":188,"color":189,"variant":229},"lg","outline","Browse the examples",[182,232,233,243,252,259,266,273,281,289],{"v-slot:features":172},[234,235,237,240],"u-page-feature",{"icon":236},"i-lucide-calendar-days",[182,238,239],{"v-slot:title":172},"Date picker",[182,241,242],{"v-slot:description":172},"Pick one date or several, inline or in a modal behind a typeable input.",[234,244,246,249],{"icon":245},"i-lucide-calendar-range",[182,247,248],{"v-slot:title":172},"Ranges and presets",[182,250,251],{"v-slot:description":172},"Select one range or many, with minimum and maximum lengths and one-click presets.",[234,253,254,256],{"icon":44},[182,255,41],{"v-slot:title":172},[182,257,258],{"v-slot:description":172},"Show two or more months side by side, linked or independent.",[234,260,261,263],{"icon":49},[182,262,46],{"v-slot:title":172},[182,264,265],{"v-slot:description":172},"Add hours and minutes to a single date, a range or several dates.",[234,267,268,270],{"icon":69},[182,269,147],{"v-slot:title":172},[182,271,272],{"v-slot:description":172},"Restyle everything with --vfc-* custom properties, in light and dark.",[234,274,275,278],{"icon":74},[182,276,277],{"v-slot:title":172},"Keyboard and ARIA",[182,279,280],{"v-slot:description":172},"Arrow-key naviga